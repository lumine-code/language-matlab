{
  "name": "MATLAB",
  "scopeName": "source.matlab",
  "type": "tree-sitter",
  "parser": "tree-sitter-matlab",
  "injectionNames": ["matlab"],
  "contentRegex": "^\\s*(function\\s|classdef\\s)|^%%",
  "fileTypes": ["m", "matlab"],
  "comments": {
    "start": "% "
  },
  "treeSitter": {
    "parserSource": "github:acristoffers/tree-sitter-matlab#ff2f83da49bb06128c4cfd055e7c95c05c77cded",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "grammar": "matlab.wasm",
    "tagsQuery": "matlab-tags.scm",
    "highlightsQuery": "matlab-highlights.scm",
    "localsQuery": "matlab-locals.scm",
    "foldsQuery": "matlab-folds.scm",
    "injectionsQuery": "matlab-injections.scm",
    "indentsQuery": "matlab-indents.scm"
  }
}
