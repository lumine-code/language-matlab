{
  "name": "MATLAB",
  "scopeName": "source.matlab",
  "type": "tree-sitter",
  "parser": "tree-sitter-matlab",
  "injectionRegex": "^(matlab)$",
  "contentRegex": "^\\s*(function\\s|classdef\\s)|^%%",
  "fileTypes": ["m", "matlab"],
  "comments": {
    "start": "% "
  },
  "treeSitter": {
    "parserSource": "github:acristoffers/tree-sitter-matlab#v1.3.0",
    "wasmBuildTool": "tree-sitter-cli#v0.26.11",
    "grammar": "tree-sitter-matlab/tree-sitter-matlab.wasm",
    "highlightsQuery": "tree-sitter-matlab/highlights.scm",
    "localsQuery": "tree-sitter-matlab/locals.scm",
    "foldsQuery": "tree-sitter-matlab/folds.scm"
  }
}
